    'TINFO:8,16,0,"00008.mpls"',
    'TINFO:8,27,0,"Parallel World Pharmacy D1_t08.mkv"',
    'TINFO:9,9,0,"0:01:00"',
    'TINFO:9,16,0,"00008.m2ts"',
    'TINFO:9,27,0,"Parallel World Pharmacy D1_t09.mkv"',
    'TINFO:10,9,0,"0:12:42"',
    'TINFO:10,16,0,"00026.m2ts"',
    'TINFO:10,27,0,"Parallel World Pharmacy D1_t10.mkv"',
]


def selftest():
    """Fixtures for the parts that must not be wrong: the robot parser, the
    destination and title formats, the verifier, the health attribution and the
    start gate. No hardware, no makemkvcon."""
    global STAGING
    STAGING = "/stage"

    f = mkvdev.split_fields('5010,0,1,"a, \\"b\\"","fmt %1","x"')
    assert f == ["5010", "0", "1", 'a, "b"', "fmt %1", "x"], f

    p = RobotParser()
    lines = [
        'MSG:1005,0,1,"MakeMKV v2.0.0 linux(x64-release) started","%1 started","MakeMKV v2.0.0"',
        'PRGT:5018,0,"Opening Blu-ray disc"', 'PRGC:3307,0,"Scanning contents"',
        'PRGV:10,20,100',
        'CINFO:2,0,"FATE_ZERO_D1"', 'CINFO:32,0,"FATE_ZERO_D1"',
        'TINFO:0,2,0,"Fate/Zero"', 'TINFO:0,9,0,"0:24:30"', 'TINFO:0,11,0,"5000000000"',
        'TINFO:0,16,0,"00800.mpls"', 'TINFO:0,27,0,"FATE_ZERO_D1_t00.mkv"',
        'TINFO:1,9,0,"0:24:31"', 'TINFO:1,27,0,"FATE_ZERO_D1_t01.mkv"',
        'TINFO:2,9,0,"0:00:20"', 'TINFO:2,27,0,"FATE_ZERO_D1_t02.mkv"',
        'PRGT:5018,0,"Saving all titles to MKV files"',
    ]
    for l in lines:
        p.feed(l)
    assert not p.copying and p.percent == 20.0 and p.version.startswith("MakeMKV v2.0.0")
    p.feed('PRGC:5017,0,"Analyzing seamless segments"')
    assert not p.copying, "seamless-segment analysis must not open the stagger gate"
    p.feed('PRGC:5018,0,"Saving to MKV file"')
    assert p.copying
    p.feed('PRGV:50,50,100')
    assert p.percent == 50.0
    assert p.title_seconds(0) == 1470 and p.disc[32] == "FATE_ZERO_D1"
    p.feed('MSG:5005,0,0,"Copy complete. 2 titles saved.","Copy complete. %1 titles saved.","2"')
    assert (p.saved, p.failed) == (2, 0) and not p.errors and not p.fatal
    p.feed("garbage line with no colon")
    p.feed("TINFO:oops")

    files = {"FATE_ZERO_D1_t00.mkv": 1470.4, "FATE_ZERO_D1_t01.mkv": 1470.9}
    assert check_rip(0, p, files, 60) == []
    assert any("exited 2" in b for b in check_rip(2, p, files, 60))
    assert any("no file was written" in b for b in check_rip(0, p, {"FATE_ZERO_D1_t00.mkv": 1470.0}, 60))
    assert any("vs 1470s" in b for b in check_rip(0, p, {**files, "FATE_ZERO_D1_t00.mkv": 1200.0}, 60))
    assert any("ffprobe" in b for b in check_rip(0, p, {**files, "FATE_ZERO_D1_t00.mkv": None}, 60))
    assert any("no .mkv" in b for b in check_rip(0, p, {}, 60))
    assert any("cannot verify" in b for b in check_rip(0, p, {**files, "stray.mkv": 5.0}, 60))

    bad = RobotParser()
    bad.feed('MSG:2003,16,3,"Error \'Scsi error - MEDIUM ERROR\' occurred while reading \'/x\' at offset \'1\'",'
             '"Error \'%1\' occurred while reading \'%2\' at offset \'%3\'","a","b","c"')
    bad.feed('MSG:5021,131332,1,"This application version is too old.","fmt","u"')
    bad.feed('MSG:5004,0,0,"Copy complete. 1 titles saved, 1 failed.","fmt","1","1"')
    assert len(bad.errors) == 1 and bad.fatal and (bad.saved, bad.failed) == (1, 1)
    assert len(check_rip(0, bad, files, 60)) >= 3

    anime = {"serial": "S", "category": "anime", "series": "Fate/Zero", "season": 1, "disc": 2}
    assert destination(anime) == "/stage/anime/Fate - Zero/Season 01/Disc 02"
    assert segment_title(anime) == "Fate/Zero"
    hentai = {"serial": "S", "category": "hentai", "series": "X", "season": None, "disc": 1}
    assert destination(hentai) == "/stage/hentai/X/Disc 01"
    assert segment_title(hentai) == "X"
    movie = {"serial": "M", "category": "movies", "title": "Akira (1988)"}
    assert destination(movie) == "/stage/movies/Akira (1988)"
    assert segment_title(movie) == "Akira (1988)"
    film = {"serial": "F", "category": "anime", "series": "Revue Starlight", "season": None,
            "disc": 3, "container_title": "Revue Starlight: The Movie (2021)"}
    assert destination(film) == "/stage/anime/Revue Starlight/Disc 03"
    assert segment_title(film) == "Revue Starlight: The Movie (2021)"
    validate_plan({"discs": [film]})
    for bad_film in ({**film, "container_title": " "}, {**movie, "container_title": "x"}):
        try:
            validate_plan({"discs": [bad_film]})
            raise AssertionError("accepted a bad container_title")
        except ValueError:
            pass

    ok = validate_plan({"discs": [anime, movie]})
    assert ok["max_concurrent"] == 3 and ok["spinup_gap_seconds"] == 30
    for broken in ({"discs": []}, {"discs": [anime, anime]}, {"discs": [{**anime, "season": None}]},
                   {"discs": [{**movie, "disc": 1}]}, {"discs": [anime], "typo": 1},
                   {"discs": [anime], "max_concurrent": 0}, {"discs": [{**anime, "serial": "T"}, {**anime, "serial": "U"}]}):
        try:
            validate_plan(broken)
        except ValueError:
            continue
        raise AssertionError(f"plan accepted: {broken}")

    assert parse_health_line("usb 5-1.2-port3: attempt power cycle") is None
    assert parse_health_line("usb 5-1.2-port3: disabled by hub (EMI?), re-enabling... error -71") == "5-1.2.3"
    assert parse_health_line("usb 5-1.2.1: USB disconnect, device number 9") == "5-1.2.1"
    assert parse_health_line("usb 5-1.2: reset high-speed USB device number 4 using xhci_hcd") == "5-1.2"
    assert parse_health_line("usb 5-1.4.3.3: new full-speed USB device number 12") == "5-1.4.3.3"
    assert parse_health_line("usb 3-2: USB disconnect, device number 2") == "3-2"
    assert parse_health_line("eth0: link up") is None
    assert port_covers("5-1.2", "5-1.2.1") and port_covers("5-1.2.1", "5-1.2.1")
    assert not port_covers("5-1.2", "5-1.20") and not port_covers("5-1.2", "5-1.3.3")
    assert port_covers("5", "5-1.4.3.3") and not port_covers("5", "6-1")

    cfg = {"max_concurrent": 2, "spinup_gap_seconds": 30}
    d = lambda *states: [{"state": s} for s in states]
    assert may_start(100, d("pending"), cfg, None, None)
    assert not may_start(100, d("scanning", "pending"), cfg, None, None), "one scanning at a time"
    assert not may_start(100, d("ripping", "ripping", "pending"), cfg, None, None), "concurrency cap"
    assert may_start(100, d("ripping", "done", "pending"), cfg, None, None)
    assert not may_start(100, d("ripping", "pending"), cfg, 130, None), "spin-up gap"
    assert may_start(131, d("ripping", "pending"), cfg, 130, None)
    assert not may_start(100, d("pending"), cfg, None, 160), "health pause"
    assert may_start(161, d("pending"), cfg, None, 160)
    q = RobotParser()
    for l in ['PRGT:5018,0,"Saving all titles to MKV files"', 'PRGC:5018,0,"Saving to MKV file"',
              'PRGC:5018,0,"Saving to MKV file"', 'PRGV:30,60,120']:
        q.feed(l)
    assert q.saves_started == 2 and (q.pv_total, q.pv_max) == (60, 120)
    view = status_view({"run_id": "r", "state": "running", "started": "t", "finished": None,
                        "health": {"dmesg": "unavailable: x", "paused_until": "z", "events": [{"detail": "boom"}]},
                        "discs": [{"serial": "S", "dest": "/d", "state": "pending", "reason": None, "progress": None,
                                   "titles_done": 0, "titles_total": None, "errors": []}]})
    assert view["health"] == {"dmesg_available": False, "paused": True, "pause_reason": "boom"}
    assert set(view) == {"run_id", "state", "started_at", "finished_at", "discs", "health"}
    global RUNS_ROOT, pid_alive, duration
    real_alive = pid_alive
    with tempfile.TemporaryDirectory() as tmp:
        RUNS_ROOT = tmp
        def mk(rid, state, pid):
            os.makedirs(os.path.join(tmp, rid))
            write_json(os.path.join(tmp, rid, "state.json"), {
                "run_id": rid, "state": state, "started": "t0", "finished": None, "controller_pid": pid,
                "health": {"dmesg": "ok", "paused_until": None, "events": []},
                "discs": [{"index": 0, "serial": "S", "dest": "/d", "state": "scanning", "reason": None,
                           "progress": None, "titles_done": 0, "titles_total": None, "errors": []}]})
        pid_alive = lambda pid: pid == 111
        mk("a-dead", "running", 222)
        mk("b-done", "complete", 333)
        assert active_run() is None, "a dead controller must not block new runs"
        dead = load_status("a-dead")
        assert dead["state"] == "incomplete" and dead["reason"] == "controller died"
        assert dead["discs"][0]["state"] == "failed"
        with open(os.path.join(tmp, "a-dead", "state.json")) as fh:
            assert json.load(fh)["state"] == "incomplete", "verdict must be persisted"
        mk("c-live", "running", 111)
        assert active_run() == "c-live"
        try:
            refuse_if_busy()
        except SystemExit as exc:
            assert "c-live" in str(exc)
        else:
            raise AssertionError("a second run was allowed")
        import io, contextlib
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            cmd_list()
        listed = json.loads(buf.getvalue())
        assert [r["run_id"] for r in listed] == ["a-dead", "b-done", "c-live"]
        assert set(listed[0]) == {"run_id", "state", "started_at"}
    RUNS_ROOT, pid_alive = DEFAULT_RUNS_ROOT, real_alive

    # ---- title info pre-pass: a real mkv log has no TINFO, the info log supplies it
    def parsed(lines, parser=None):
        parser = parser or RobotParser()
        for l in lines:
            parser.feed(l)
        return parser

    def verified(info_lines=INFO_LOG, info_rc=0):
        rip = parsed(RIP_LOG)
        rip.take_info(parsed(info_lines), info_rc)
        rip.check_announced()
        return rip

    rip = parsed(RIP_LOG)
    assert not rip.titles and len(rip.announced) == 11 and rip.announced[0] == "00009.mpls"
    rip = verified()
    assert rip.info_problems == [] and len(rip.titles) == 11 and rip.disc[32] == "ParallelWorldPharmacy_D1"
    assert (rip.saved, rip.failed) == (11, 0)
    disc = {"suspect": []}
    sync_disc(disc, rip, 60)
    assert disc["titles_total"] == 11 and disc["errors"] == []
    names = {tid: a[27] for tid, a in rip.titles.items()}
    disk = {name: rip.title_seconds(tid) + 0.4 for tid, name in names.items()}
    assert len(disk) == 11 and check_rip(0, rip, disk, 60) == []
    assert any("not recorded" in b for b in check_rip(None, rip, disk, 60))
    assert any("exited 1" in b for b in check_rip(1, rip, disk, 60))
    assert any("vs 1422s" in b for b in check_rip(0, rip, {**disk, names[0]: 900.0}, 60))

    swapped = [l.replace('"00012.mpls"', '"00099.mpls"') if l.startswith("TINFO:3,16,") else l for l in INFO_LOG]
    mismatch = verified(swapped)
    assert len(mismatch.info_problems) == 1 and "title 3 is 00012.mpls in the rip but 00099.mpls" in mismatch.info_problems[0]
    assert any("title 3 is" in b for b in check_rip(0, mismatch, disk, 60))
    no_ten = [l for l in INFO_LOG if not l.startswith("TINFO:10,")]
    assert "title 10 is 00026.m2ts in the rip but missing" in verified(no_ten).info_problems[0]
    assert any("info pass exited 1" in b for b in check_rip(0, verified(INFO_LOG, 1), disk, 60))
    fatal_info = parsed(['MSG:5010,0,1,"Failed to open disc","fmt"'])
    gone = RobotParser()
    gone.take_info(fatal_info, 0)
    assert any("fatal error: Failed to open disc" in b for b in gone.info_problems)
    assert any("announces no titles" in b for b in (lambda r: (r.take_info(parsed(INFO_LOG), 0), r.check_announced(), r.info_problems)[2])(RobotParser()))

    # ---- legacy runs stored no exit status: infer it from the log, conservatively
    assert recorded_rc({"makemkv_rc": 3}, rip) == 3 and recorded_rc({"makemkv_rc": 0}, parsed([])) == 0
    assert recorded_rc({}, parsed(RIP_LOG)) == 0
    assert recorded_rc({}, parsed(RIP_LOG[:-1])) is None, "no copy-complete line: unknown"
    assert recorded_rc({}, parsed(RIP_LOG + ['MSG:5004,0,0,"Copy complete. 10 titles saved, 1 failed.","fmt","10","1"'])) is None
    assert recorded_rc({}, parsed(RIP_LOG + ['MSG:5010,0,1,"Failed to open disc","fmt"'])) is None

    # ---- finalize: refuses while a run is running; plans only what can be re-verified
    with tempfile.TemporaryDirectory() as tmp:
        RUNS_ROOT = os.path.join(tmp, "runs")
        os.makedirs(os.path.join(RUNS_ROOT, "live"))
        pid_alive = lambda pid: True
        write_json(os.path.join(RUNS_ROOT, "live", "state.json"), {
            "run_id": "live", "state": "running", "started": "t", "finished": None, "controller_pid": 1,
            "health": {"dmesg": "ok", "paused_until": None, "events": []}, "discs": []})
        try:
            cmd_finalize("live", False)
        except SystemExit as exc:
            assert "still running" in str(exc) and "live" in str(exc)
        else:
            raise AssertionError("finalize ran against a running run")
        pid_alive = real_alive

        # ---- the lock gap: a held finalize blocks a new run, naming the run it is on
        write_json(os.path.join(RUNS_ROOT, "live", "state.json"), {
            "run_id": "live", "state": "complete", "started": "t", "finished": "t", "controller_pid": 1,
            "health": {"dmesg": "ok", "paused_until": None, "events": []}, "discs": []})
        assert oct(os.stat(os.path.join(RUNS_ROOT, "live", "state.json")).st_mode & 0o777) == "0o660"
        assert finalize_holder() is None
        holder = open(os.path.join(RUNS_ROOT, FINALIZE_LOCK), "a+")
        fcntl.flock(holder, fcntl.LOCK_EX | fcntl.LOCK_NB)
        holder.truncate(0)
        holder.write("live")
        holder.flush()
        assert finalize_holder() == "live"
        planfile = os.path.join(tmp, "plan.json")
        with open(planfile, "w") as fh:
            json.dump({"discs": [anime]}, fh)
        real_settings, real_env_state = mkvdev.write_makemkv_settings, os.environ.get("MKV_RIP_STATE")
        mkvdev.write_makemkv_settings = lambda: None
        os.environ["MKV_RIP_STATE"] = RUNS_ROOT
        try:
            for attempt in (lambda: cmd_start(planfile), lambda: cmd_finalize("live", False)):
                try:
                    attempt()
                except SystemExit as exc:
                    assert "finalize of run live" in str(exc), exc
                else:
                    raise AssertionError("a finalize lock did not block")
        finally:
            mkvdev.write_makemkv_settings = real_settings
            os.environ.pop("MKV_RIP_STATE")
            if real_env_state:
                os.environ["MKV_RIP_STATE"] = real_env_state
        holder.close()
        assert finalize_holder() is None

        # ---- state is only kept on a real mount: no override and no staging tree is fatal
        try:
            state_root()
        except SystemExit as exc:
            assert "staging tree" in str(exc)
        else:
            raise AssertionError("state root accepted a missing mount")

        rd = os.path.join(tmp, "plan-run")
        os.makedirs(rd)

        def planned(i, state="failed", partial=True, log=RIP_LOG, rc=None):
            dest = os.path.join(tmp, "stage", f"d{i}")
            if partial:
                os.makedirs(dest + ".partial")
            if log is not None:
                with open(os.path.join(rd, f"disc-{i:02d}.log"), "w") as fh:
                    fh.write("\n".join(log))
            return {"index": i, "serial": f"S{i}", "state": state, "dest": dest, "makemkv_rc": rc}

        st = {"discs": [planned(0), planned(1, partial=False), planned(2), planned(3, log=RIP_LOG[:-1]),
                        planned(4, rc=1), planned(5, state="done"), planned(6), planned(7, log=RIP_LOG[:-1], rc=0),
                        planned(8, log=None), planned(9)]}
        drive = lambda i, **kw: {"serial": f"S{i}", "dev": f"/dev/sr{i}", "sg": None, "usb_port": f"5-{i}",
                                 "link_mbps": 480, "tray": "closed", "media": True, "status": "disc_ok", **kw}
        fleet = [drive(0), drive(1), drive(2, link_mbps=12), drive(3), drive(4), drive(5), drive(7),
                 drive(8), drive(9, media=False, tray="open", status="no_disc")]
        todo, skipped = finalize_plan(st, rd, fleet)
        assert [t["index"] for t in todo] == [0, 7] and all(t["rc"] == 0 for t in todo)
        why = {k["index"]: k["reason"] for k in skipped}
        assert sorted(why) == [1, 2, 3, 4, 6, 8, 9], why
        assert ".partial" in why[1] and "12 Mbit/s" in why[2] and "clean copy-complete" in why[3]
        assert "exited 1" in why[4] and "not on the USB bus" in why[6] and "log" in why[8] and "no disc" in why[9]

    # ---- finalize end to end against a fake makemkvcon: the shared tail promotes a good disc
    # and keeps a mismatched one failed
    import contextlib, io, stat
    for scenario, info_lines in (("matching", INFO_LOG), ("mismatched", swapped)):
        with tempfile.TemporaryDirectory() as tmp:
            RUNS_ROOT = os.path.join(tmp, "runs")
            rd = os.path.join(RUNS_ROOT, "e2e")
            os.makedirs(rd)
            dest = os.path.join(tmp, "stage", "anime", "X", "Disc 01")
            os.makedirs(dest + ".partial")
            for name in disk:
                open(os.path.join(dest + ".partial", name), "w").close()
            with open(os.path.join(rd, "disc-00.log"), "w") as fh:
                fh.write("\n".join(RIP_LOG) + "\n")
            with open(os.path.join(tmp, "info.txt"), "w") as fh:
                fh.write("\n".join(info_lines) + "\n")
            bindir = os.path.join(tmp, "bin")
            os.makedirs(bindir)
            for tool, body in (("makemkvcon", 'cat "$FAKE_INFO"'), ("mkvpropedit", "exit 0")):
                with open(os.path.join(bindir, tool), "w") as fh:
                    fh.write(f"#!/bin/sh\n{body}\n")
                os.chmod(os.path.join(bindir, tool), 0o755)
            plan = {"discs": [{"serial": "S0", "category": "anime", "series": "X", "season": None, "disc": 1}],
                    "min_title_seconds": 60, "max_concurrent": 1, "spinup_gap_seconds": 0,
                    "health_pause_seconds": 1, "scan_timeout_seconds": 60}
            write_json(os.path.join(rd, "plan.json"), plan)
            write_json(os.path.join(rd, "state.json"), {
                "run_id": "e2e", "state": "incomplete", "started": "t", "finished": "t", "controller_pid": 1,
                "health": {"dmesg": "ok", "paused_until": None, "events": []},
                "discs": [{"index": 0, "serial": "S0", "plan": plan["discs"][0], "dest": dest, "state": "failed",
                           "reason": "not a title makemkvcon reported", "drive": None, "progress": None,
                           "started": "t", "copy_started": "t", "finished": "t", "suspect": [], "titles": None,
                           "eject": None, "titles_done": 0, "titles_total": None, "errors": []}]})
            ejected, real_env = [], dict(os.environ)
            seconds = {n: s_ for n, s_ in disk.items()}
            real = (duration, mkvdev.drives, mkvdev.eject, mkvdev.write_makemkv_settings)
            duration = lambda path: seconds[os.path.basename(path)] / 60
            mkvdev.drives = lambda: [drive(0)]
            mkvdev.eject = ejected.append
            mkvdev.write_makemkv_settings = lambda: None
            os.environ.update(PATH=bindir + os.pathsep + os.environ["PATH"], FAKE_INFO=os.path.join(tmp, "info.txt"))
            try:
                with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                    try:
                        cmd_finalize("e2e", False)
                    except SystemExit as exc:
                        code = exc.code
            finally:
                duration, mkvdev.drives, mkvdev.eject, mkvdev.write_makemkv_settings = real
                os.environ.clear()
                os.environ.update(real_env)
            with open(os.path.join(rd, "state.json")) as fh:
                final = json.load(fh)
            d0 = final["discs"][0]
            if scenario == "matching":
                assert code == 0 and final["state"] == "complete" and final["problems"] == []
                assert d0["state"] == "done" and d0["reason"] is None and d0["makemkv_rc"] == 0 and d0["eject"] == "ok"
                assert os.path.isfile(os.path.join(dest, "manifest.json")) and not os.path.exists(dest + ".partial")
                assert len(ejected) == 1 and d0["titles_total"] == 11 and d0["titles"] == 11
            else:
                assert code == 1 and final["state"] == "incomplete" and d0["state"] == "failed"
                assert "title 3 is 00012.mpls in the rip but 00099.mpls" in d0["reason"]
                assert os.path.isdir(dest + ".partial") and not os.path.exists(dest) and not ejected
            assert os.path.isfile(os.path.join(rd, "disc-00.info.log"))
    RUNS_ROOT = DEFAULT_RUNS_ROOT
    print("selftest ok")


def main():
    args = sys.argv[1:]
    if args == ["--selftest"]:
        selftest()
        return
    if args[:1] in (["list"], ["status"], ["wait"], ["finalize"]):
        state_root()
    if len(args) == 2 and args[0] == "_run":
        Run(args[1]).main()
    elif args == ["list"]:
        cmd_list()
    elif len(args) == 2 and args[0] == "status":
        cmd_status(args[1])
    elif len(args) == 2 and args[0] == "wait":
        cmd_wait(args[1])
    elif len(args) in (2, 3) and args[0] == "finalize" and args[2:] in ([], ["--dry-run"]):
        cmd_finalize(args[1], bool(args[2:]))
    elif len(args) == 1 and not args[0].startswith("-"):
        cmd_start(args[0])
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
