#!/usr/bin/env python3
"""Rip discs into _pending, a few at a time, without knocking drives off the bus.

usage: mkv-rip PLAN.json            start a run detached; prints its run id
       mkv-rip status RUN_ID        JSON: per-disc state, progress, errors
       mkv-rip wait RUN_ID          block until the run is terminal
       mkv-rip list                 every run: id, state, start time
       mkv-rip finalize RUN_ID [--dry-run]
                                    re-verify a run's failed discs that are still
                                    in their drives, and promote the good ones
       mkv-rip --selftest           parser / scheduler / verifier fixtures

plan: {"discs": [{"serial": "BP52...", "category": "anime", "series": "Name",
                  "season": 1, "disc": 2},
                 {"serial": "BP52...", "category": "movies", "title": "Name (Year)"}],
       "min_title_seconds": 60, "max_concurrent": 3, "spinup_gap_seconds": 30,
       "health_pause_seconds": 120, "scan_timeout_seconds": 900}   # all optional

Destinations, under $MEDIA_ROOT/dxp6800/_pending/:
  anime, tv   <category>/<Series>/Season XX/Disc XX/
  hentai      the same, with `season: null` dropping the Season level
  movies      movies/<Title (Year)>/

Why this is a controller and not a loop around makemkvcon: the drives share one
powered USB 2.0 hub tree, and spinning several up together has knocked drives
off the bus. There is no power sensor to ask, so starts are gated in software --
one drive scanning at a time, a gap after it begins copying, and a pause when
the USB tree reports errors. Nothing is ever overwritten: a destination that
already exists blocks that disc.

Disc states: pending, blocked, scanning, ripping, done, failed, suspect.
`suspect` means the rip finished but the USB tree misbehaved under that drive;
it is kept as .partial for a human to judge, never promoted automatically.
A run is `complete` only when every disc is `done`; otherwise `incomplete`.

Title lengths come from a separate pre-pass: `mkv` mode prints no TINFO lines, so
each disc is first read with `makemkvcon info` (same scanning slot), and the rip
is checked against that table. See SPEC.md section 10 for why, and for `finalize`.
"""
import collections
import datetime
import fcntl
import json
import os
import re
import secrets
import signal
import subprocess
import sys
import tempfile
import threading
import time

from mkvlib import MEDIA_ROOT, duration
import mkvdev

STAGING = os.path.join(MEDIA_ROOT, "dxp6800", "_pending")
# Run state lives on the NAS beside what it describes, not on the pod's emptyDir:
# a pod roll must not take the only record of which discs were ripped, with it.
# MKV_RIP_STATE exists for the selftest and skips the mount guard.
DEFAULT_RUNS_ROOT = os.path.join(STAGING, ".rips")
RUNS_ROOT = os.environ.get("MKV_RIP_STATE") or DEFAULT_RUNS_ROOT
FINALIZE_LOCK = "finalize.lock"

CATEGORIES = ("anime", "tv", "hentai", "movies")
SERIES_CATEGORIES = ("anime", "tv", "hentai")
DEFAULTS = {"min_title_seconds": 60, "max_concurrent": 3, "spinup_gap_seconds": 30,
            "health_pause_seconds": 120, "scan_timeout_seconds": 900}
DISC_KEYS = {"serial", "category", "series", "season", "disc", "title", "container_title"}

TERMINAL_DISC = ("done", "failed", "blocked", "suspect")
TERMINAL_RUN = ("complete", "incomplete")
ACTIVE = ("scanning", "ripping")

# The scanning -> copying transition is read from makemkvcon's progress titles.
# A `mkv ... all` run walks: PRGT "Opening Blu-ray disc"/"Opening DVD disc" (spin
# up, then PRGCs such as "Scanning contents", "Processing AV clips", "Processing
# BD+ code", "Loading playlists" -- the disc analysis), then PRGT "Saving all
# titles to MKV files" / "Saving %1 titles into directory %2", whose PRGCs are
# "Analyzing seamless segments" and then "Saving to MKV file".
# The gate keys on the PRGC "Saving to MKV file" *under* a "Saving..." PRGT.
# "Analyzing seamless segments" is deliberately NOT copying: it is still
# analysis, seeking around the playlists, and the drive is not yet streaming.
# Names, not the numeric codes, because the codes are internal ids that have
# moved between releases while the English progress text has not.
SAVE_PRGT_PREFIX = "Saving"
COPY_PRGC = "Saving to MKV file"

# MSG lines that mean data was not read or written faithfully. Matched against
# the message's format string ("Error '%1' occurred while reading '%2' at offset
# '%3'"), which is stable where the formatted text is not. A rip with any of
# these is not trusted, even if makemkvcon went on to exit 0.
BAD_MSG_RE = re.compile(
    r"occurred while|Scsi error|Failed to save title|corrupt or invalid|"
    r"Hash check failed|Too many hash check errors", re.I)
# Fatal for the whole run, not one title: the licence, or the disc not opening.
FATAL_MSG_CODES = {5009, 5010, 5020, 5021}

# Tolerance between MakeMKV's reported title length and ffprobe's. Reported
# lengths are whole seconds, so very short titles get a two-second floor.
DURATION_TOLERANCE = 0.02
DURATION_FLOOR_SECONDS = 2.0

# Kernel lines that mean the USB tree is struggling. Matched only when they name
# a port, so unrelated USB devices elsewhere on the host do not pause a rip.
HEALTH_RE = re.compile(
    r"error -71|USB disconnect|\bdisconnect|reset (?:full|high|low|super)[- ]?speed|"
    r"device descriptor read|unable to enumerate|device not accepting address|"
    r"over-?current|cannot enable|new full-speed", re.I)


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def log(msg):
    print(f"{now_iso()} {msg}", flush=True)


# --------------------------------------------------------------------- plan

def sanitize(name):
    """Only '/' is illegal in a path component; everything else is the title."""
    return re.sub(r"\s*/\s*", " - ", name).strip()


def _component(value, what):
    if not isinstance(value, str) or not sanitize(value) or sanitize(value) in (".", ".."):
        raise ValueError(f"{what} must be a non-empty string")
    if "\0" in value:
        raise ValueError(f"{what} contains a NUL")
    return sanitize(value)


def destination(entry):
    cat = entry["category"]
    if cat == "movies":
        return os.path.join(STAGING, "movies", _component(entry.get("title"), "title"))
    parts = [STAGING, cat, _component(entry.get("series"), "series")]
    if entry.get("season") is not None:
        parts.append(f"Season {entry['season']:02d}")
    parts.append(f"Disc {entry['disc']:02d}")
    return os.path.join(*parts)


def segment_title(entry):
    """The MKV segment title, matching what anime-normalize sets.

    This is the container title field of the MakeMKV GUI: the canonical series
    name for every title on a series disc (episodes and extras alike), and
    `Title (Year)` for a movie. Episode names live in filenames, which
    anime-normalize assigns after verifying the order by dialogue.
    """
    if entry["category"] == "movies":
        return entry["title"]
    # A film that ships inside a series box set is filed with the series, but
    # its container title is the film's own (`Series: Film (Year)`), as
    # anime-normalize titles movie files.
    return entry.get("container_title") or entry["series"]


def _int(value, what, lo, hi=None):
    if isinstance(value, bool) or not isinstance(value, int) or value < lo or (hi and value > hi):
        raise ValueError(f"{what} must be an integer >= {lo}" + (f" and <= {hi}" if hi else ""))
    return value


def validate_plan(plan):
    """-> plan with defaults filled in. Raises ValueError with a message that
    names the offending entry; a typo caught here costs nothing, caught after a
    drive spins up it costs a disc's worth of time."""
    if not isinstance(plan, dict):
        raise ValueError("plan must be a JSON object")
    unknown = set(plan) - set(DEFAULTS) - {"discs"}
    if unknown:
        raise ValueError(f"unknown plan keys: {sorted(unknown)}")
    discs = plan.get("discs")
    if not isinstance(discs, list) or not discs:
        raise ValueError("plan.discs must be a non-empty list")

    out = {k: _int(plan.get(k, v), k, 0 if k == "spinup_gap_seconds" else 1,
                   16 if k == "max_concurrent" else None) for k, v in DEFAULTS.items()}
    seen_serials, seen_dests, entries = set(), set(), []
    for i, e in enumerate(discs):
        who = f"discs[{i}]"
        if not isinstance(e, dict) or set(e) - DISC_KEYS:
            raise ValueError(f"{who}: expected an object with keys from {sorted(DISC_KEYS)}")
        if not isinstance(e.get("serial"), str) or not e["serial"]:
            raise ValueError(f"{who}: serial is required")
        if e.get("category") not in CATEGORIES:
            raise ValueError(f"{who}: category must be one of {CATEGORIES}")
        try:
            if e["category"] in SERIES_CATEGORIES:
                _component(e.get("series"), "series")
                _int(e.get("disc"), "disc", 1)
                if "container_title" in e and (not isinstance(e["container_title"], str)
                                               or not e["container_title"].strip()):
                    raise ValueError("container_title must be a non-empty string")
                if e.get("season") is None:
                    # A season-less disc is either hentai or a film filed with its
                    # series, which says so by carrying its own container title.
                    # Anything else is a forgotten season, caught before a spin-up.
                    if e["category"] != "hentai" and "container_title" not in e:
                        raise ValueError("season is required (null only for hentai, or a film disc with container_title)")
                else:
                    _int(e["season"], "season", 0)
            else:
                _component(e.get("title"), "title")
                extra = {"series", "season", "disc", "container_title"} & set(e)
                if extra:
                    raise ValueError(f"{sorted(extra)} do not apply to movies")
        except ValueError as exc:
            raise ValueError(f"{who}: {exc}") from None
        dest = destination(e)
        if e["serial"] in seen_serials:
            raise ValueError(f"{who}: serial {e['serial']} appears twice")
        if dest in seen_dests:
            raise ValueError(f"{who}: destination {dest} is already claimed by an earlier disc")
        seen_serials.add(e["serial"])
        seen_dests.add(dest)
        entries.append(e)
    out["discs"] = entries
    return out


def staging_root():
    """The staging tree, checked to be the NAS and not the pod's overlay.

    Same reasoning as mkvlib.archive_root(): if the mount is missing, a rip into
    the overlay "succeeds" and is discarded at the next image roll. Never created.
    """
    if not os.path.isdir(STAGING):
        raise SystemExit(f"FATAL: staging tree does not exist: {STAGING}\n"
                         "Create it on the NAS; creating it from the pod would land on the overlay.")
    if os.stat(STAGING).st_dev == os.stat("/").st_dev:
        raise SystemExit(f"FATAL: {STAGING} is on the pod's root filesystem -- the mount is missing.")
    if not os.access(STAGING, os.W_OK | os.X_OK):
        raise SystemExit(f"FATAL: {STAGING} is not writable.")


def state_root():
    """The run-state directory, created on first use once its mount is vouched for.

    Guarded like staging: state written into the overlay would look durable and
    be gone at the next image roll.
    """
    if not os.environ.get("MKV_RIP_STATE"):
        staging_root()
    os.makedirs(RUNS_ROOT, exist_ok=True)


# ------------------------------------------------------------ robot parsing

def hms(value):
    """'1:23:45' -> seconds, or None."""
    try:
        h, m, s = (int(x) for x in value.split(":"))
    except ValueError:
        return None
    return h * 3600 + m * 60 + s


class RobotParser:
    """Accumulates what a `makemkvcon -r mkv` run says about itself."""

    def __init__(self):
        self.titles = collections.defaultdict(dict)   # id -> {TINFO attr: value}
        self.disc = {}                                # CINFO attr -> value
        self.prgt = self.prgc = ""
        self.percent = 0.0
        self.pv_total = self.pv_max = 0
        self.saves_started = 0                        # "Saving to MKV file" steps seen
        self.copying = False
        self.errors = []                              # MSG lines that void the rip
        self.fatal = None
        self.saved = self.failed = None
        self.version = None
        self.announced = {}                           # title id -> playlist, from MSG 3307
        self.info_problems = []                       # why the info pass cannot vouch for the rip

    def feed(self, line):
        kind, _, rest = line.rstrip("\r\n").partition(":")
        if kind not in ("MSG", "PRGT", "PRGC", "PRGV", "TINFO", "CINFO"):
            return
        f = mkvdev.split_fields(rest)
        try:
            getattr(self, "_" + kind.lower())(f, line)
        except (IndexError, ValueError):
            pass    # a malformed line is not worth failing a rip over; the log has it raw

    def _prgt(self, f, _line):
        self.prgt = f[2]

    def _prgc(self, f, _line):
        self.prgc = f[2]
        if self.prgt.startswith(SAVE_PRGT_PREFIX) and self.prgc == COPY_PRGC:
            self.copying = True
            self.saves_started += 1

    def _prgv(self, f, _line):
        cur, total, mx = int(f[0]), int(f[1]), int(f[2])
        self.pv_total, self.pv_max = total, mx
        if mx:
            self.percent = round(100.0 * total / mx, 1)

    def _tinfo(self, f, _line):
        self.titles[int(f[0])][int(f[1])] = f[3]

    def _cinfo(self, f, _line):
        self.disc[int(f[0])] = f[2]

    def _msg(self, f, line):
        code = int(f[0])
        text = f[3] if len(f) > 3 else ""
        fmt = f[4] if len(f) > 4 else text
        if code == 1005:
            self.version = text
        elif code == 3307:
            self.announced[int(f[6])] = f[5]
        elif code == 5005:
            self.saved, self.failed = int(f[5]), 0
        elif code == 5004:
            self.saved, self.failed = int(f[5]), int(f[6])
        if code in FATAL_MSG_CODES and not self.fatal:
            self.fatal = text
        if BAD_MSG_RE.search(fmt) or BAD_MSG_RE.search(text):
            self.errors.append(line.rstrip("\r\n"))

    def title_seconds(self, tid):
        return hms(self.titles[tid].get(9, ""))

    def take_info(self, info, info_rc):
        """Adopt the title table from an `info` pass over the same disc.

        `mkv` mode never prints TINFO, so the table (lengths, output names, source
        playlists) can only come from `info`. Its exit code and fatal messages
        count against the rip like the rip's own.
        """
        self.titles, self.disc = info.titles, info.disc
        bad = self.info_problems = []
        if info_rc != 0:
            bad.append(f"the title info pass exited {info_rc}")
        if info.fatal:
            bad.append(f"the title info pass reported a fatal error: {info.fatal}")
        if info.errors:
            bad.append(f"{len(info.errors)} read error message(s) from the title info pass")
        if not info.titles:
            bad.append("the title info pass listed no titles")

    def check_announced(self):
        """Cross-check the rip against the adopted table. Title ids are positions
        in a list each invocation builds for itself; if the two disagree about
        which playlist an id is, the rip would be verified against the wrong
        lengths. Every id the rip announced ("File 00009.mpls was added as title
        #0") must name the same source playlist (TINFO 16) in the table."""
        if not self.announced:
            self.info_problems.append(
                "the rip log announces no titles, so it cannot be matched to the title info")
        for tid, playlist in sorted(self.announced.items()):
            listed = self.titles.get(tid, {}).get(16)
            if listed != playlist:
                self.info_problems.append(
                    f"title {tid} is {playlist} in the rip but {listed or 'missing'} in the "
                    "title info pass; the disc may have changed between them")


# ------------------------------------------------------------- verification

def title_for_file(parser, fname):
    """The title id a ripped file belongs to: by its reported output name, else
    by the _tNN suffix MakeMKV puts on every file it names."""
    for tid, attrs in parser.titles.items():
        if attrs.get(27) == fname:
            return tid
    m = re.search(r"_t(\d+)\.mkv$", fname)
    return int(m.group(1)) if m and int(m.group(1)) in parser.titles else None


def check_rip(rc, parser, files, min_title_seconds):
    """-> list of reasons this rip cannot be trusted; empty means it can.

    `files` maps each ripped file name to its measured seconds (None when
    ffprobe could not read it); `rc` is makemkvcon's exit status, None when it
    was never recorded. Pure, so the selftest can drive it.
    """
    bad = list(parser.info_problems)
    if rc is None:
        bad.append("makemkvcon's exit status was not recorded and its log has no clean copy-complete line")
    elif rc != 0:
        bad.append(f"makemkvcon exited {rc}")
    if parser.fatal:
        bad.append(f"fatal: {parser.fatal}")
    if parser.errors:
        bad.append(f"{len(parser.errors)} read/write error message(s) from makemkvcon")
    if parser.failed:
        bad.append(f"makemkvcon reports {parser.failed} title(s) failed to save")
    if not files:
        bad.append("no .mkv files were produced")

    matched = set()
    for fname, secs in sorted(files.items()):
        tid = title_for_file(parser, fname)
        if tid is None:
            bad.append(f"{fname}: not a title makemkvcon reported, cannot verify its length")
            continue
        matched.add(tid)
        want = parser.title_seconds(tid)
        if secs is None:
            bad.append(f"{fname}: ffprobe could not read it")
        elif want is None:
            bad.append(f"{fname}: makemkvcon gave no length for title {tid}")
        elif abs(secs - want) > max(DURATION_TOLERANCE * want, DURATION_FLOOR_SECONDS):
            bad.append(f"{fname}: {secs:.1f}s on disk vs {want}s reported")
    for tid in sorted(set(parser.titles) - matched):
        want = parser.title_seconds(tid)
        if want is not None and want >= min_title_seconds and files:
            bad.append(f"title {tid} ({want}s) was reported but no file was written for it")
    return bad


# ------------------------------------------------------------- health watch

def parse_health_line(line):
    """-> a USB port name this kernel line is about, or None.

    Port-level lines name the child as `<hub>-port<N>`, which is the device at
    `<hub>.<N>`; the bare root-hub form (`usb usb5`) names a whole bus.
    """
    if not HEALTH_RE.search(line):
        return None
    m = re.search(r"(\d+-\d+(?:\.\d+)*)-port(\d+)", line)
    if m:
        return f"{m.group(1)}.{m.group(2)}"
    m = re.search(r"\b(?:usb|hub) (\d+-\d+(?:\.\d+)*)\b", line)
    if m:
        return m.group(1)
    m = re.search(r"\busb (?:usb)?(\d+)\b", line)
    return m.group(1) if m else None


def port_covers(event_port, drive_port):
    """Does an event on `event_port` touch a drive on `drive_port`? A hub or bus
    event reaches everything beneath it: one reset on 5-1.2 hits all three
    drives behind it."""
    if "-" not in event_port:
        return drive_port.split("-")[0] == event_port
    return drive_port == event_port or drive_port.startswith(event_port + ".")


class HealthWatch:
    """Notices the USB tree misbehaving. sysfs first, dmesg when it is allowed.

    dmesg is usually unreadable for the pod's uid (kernel.dmesg_restrict), so the
    watch cannot depend on it. The signals sysfs does give are the ones that
    matter here: a drive's link falling out of 480, its USB device vanishing, or
    its sr node disappearing -- exactly how the 2026-11-09 failure looked.
    """

    def __init__(self, known):
        self.known = {d["usb_port"]: d for d in known}
        self.speed = {p: d["link_mbps"] for p, d in self.known.items()}
        self.down = set()
        self.seen_dmesg = None
        self.dmesg = "ok"

    def poll_sysfs(self):
        events = []
        for port, d in self.known.items():
            sr = os.path.basename(d["dev"])
            if not os.path.isdir(d["usb_dir"]):
                if (port, "usb") not in self.down:
                    self.down.add((port, "usb"))
                    events.append({"port": port, "kind": "usb_device_gone", "detail": f"{port} left the bus"})
                continue
            self.down.discard((port, "usb"))
            if not os.path.exists(os.path.join(mkvdev.SYS_BLOCK, sr)):
                if (port, "sr") not in self.down:
                    self.down.add((port, "sr"))
                    events.append({"port": port, "kind": "sr_node_gone", "detail": f"{sr} disappeared"})
            else:
                self.down.discard((port, "sr"))
            now = mkvdev.link_mbps(d["usb_dir"])
            if now is not None and self.speed.get(port) and now < self.speed[port]:
                events.append({"port": port, "kind": "link_dropped",
                               "detail": f"{port} fell from {self.speed[port]} to {now} Mbit/s"})
            if now is not None:
                self.speed[port] = now
        return events

    def poll_dmesg(self):
        r = subprocess.run(["dmesg"], capture_output=True, text=True)
        if r.returncode != 0:
            self.dmesg = f"unavailable: {(r.stderr or 'dmesg failed').strip()[:100]}"
            return []
        self.dmesg = "ok"
        buses = {p.split("-")[0] for p in self.known}
        current = collections.Counter(r.stdout.splitlines())
        if self.seen_dmesg is None:          # first read is the baseline, not news
            self.seen_dmesg = current
            return []
        fresh = current - self.seen_dmesg
        self.seen_dmesg = current
        events = []
        for line in fresh.elements():
            port = parse_health_line(line)
            if port and port.split("-")[0] in buses:
                events.append({"port": port, "kind": "dmesg", "detail": line.strip()[:200]})
        return events


# --------------------------------------------------------------- scheduling

def may_start(now, discs, cfg, gate_open_at, paused_until):
    """Is the controller allowed to spin up another drive right now?

    Three independent brakes, all of which must be off:
      - concurrency: at most max_concurrent rips running;
      - scanning: only one drive in spin-up/analysis at a time, because that is
        the phase that draws the surge;
      - the gap: spinup_gap_seconds after the previous drive left scanning, so
        its own copy ramp is settled before the next surge;
      - the health pause, after any USB error.
    """
    running = [d for d in discs if d["state"] in ACTIVE]
    if len(running) >= cfg["max_concurrent"]:
        return False
    if any(d["state"] == "scanning" for d in running):
        return False
    if gate_open_at is not None and now < gate_open_at:
        return False
    return paused_until is None or now >= paused_until


# --------------------------------------------------------------- controller

def write_json(path, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".state.")
    os.fchmod(fd, 0o660)        # mkstemp's 0600 would lock the group out of the NAS copy
    with os.fdopen(fd, "w") as fh:
        json.dump(obj, fh, indent=1)
    os.replace(tmp, path)


class Run:
    def __init__(self, run_id, state=None):
        """`state` resumes an existing run (finalize); without it, a fresh one."""
        self.id = run_id
        self.dir = os.path.join(RUNS_ROOT, run_id)
        with open(os.path.join(self.dir, "plan.json")) as fh:
            self.cfg = json.load(fh)
        self.lock = threading.RLock()
        self.stopping = False
        self.gate_open_at = None
        self.paused_until = None
        self.procs = {}
        self.state = state or {
            "run_id": run_id, "state": "running", "started": now_iso(), "finished": None,
            "controller_pid": os.getpid(),
            "health": {"dmesg": "pending", "paused_until": None, "events": []},
            "discs": [{"index": i, "serial": e["serial"], "plan": e, "dest": destination(e),
                       "state": "pending", "reason": None, "drive": None, "progress": None,
                       "started": None, "copy_started": None, "finished": None,
                       "suspect": [], "titles": None, "eject": None, "makemkv_rc": None,
                       "titles_done": 0, "titles_total": None, "errors": []}
                      for i, e in enumerate(self.cfg["discs"])],
        }

    @property
    def discs(self):
        return self.state["discs"]

    def save(self):
        with self.lock:
            self.state["health"]["paused_until"] = (
                datetime.datetime.fromtimestamp(self.paused_until).astimezone().isoformat(timespec="seconds")
                if self.paused_until and self.paused_until > time.time() else None)
            write_json(os.path.join(self.dir, "state.json"), self.state)

    def set_state(self, disc, new, reason=None):
        with self.lock:
            old = disc["state"]
            disc["state"] = new
            if reason:
                disc["reason"] = reason
            if new in TERMINAL_DISC:
                disc["finished"] = now_iso()
            if old == "scanning" and new != "scanning":
                self.gate_open_at = time.time() + self.cfg["spinup_gap_seconds"]
            log(f"disc {disc['index']} ({disc['serial']}): {old} -> {new}" + (f" -- {reason}" if reason else ""))
            self.save()

    # ---- pre-flight

    def preflight(self, disc):
        """-> blocking reason, or None. Re-run at start: a tray can open between
        planning and spin-up."""
        found = {d["serial"]: d for d in mkvdev.drives()}
        drive = found.get(disc["serial"])
        if drive is None:
            return (f"Drive {disc['serial']} is not on the USB bus; it has likely dropped off the hub "
                    "and needs the hub reset (see the makemkv skill).")
        disc["drive"] = {k: drive[k] for k in ("dev", "sg", "usb_port", "link_mbps")}
        # A drive still becoming ready reports no media for a few seconds after
        # a disc goes in; wait it out rather than block a loaded drive.
        for _ in range(10):
            if drive["status"] != "not_ready":
                break
            time.sleep(2)
            drive = {d["serial"]: d for d in mkvdev.drives()}.get(disc["serial"], drive)
        if drive["status"] == "unknown":
            return f"cannot read the drive state: {drive.get('error')}"
        if not drive["media"]:
            return f"no disc in the drive (tray {drive['tray']}, state {drive['status']})"
        if drive["link_mbps"] != 480:
            return (f"link is {drive['link_mbps']} Mbit/s, not 480: the hub tree needs the reset "
                    "runbook, which needs root on the node")
        if os.path.exists(disc["dest"]):
            return f"destination already exists: {disc['dest']}"
        if os.path.exists(disc["dest"] + ".partial"):
            return f"a .partial from an earlier run exists: {disc['dest']}.partial"
        return None

    # ---- health

    def on_health(self, events):
        if not events:
            return
        with self.lock:
            for ev in events:
                ev["time"] = now_iso()
                log(f"health: {ev['kind']} on {ev['port']}: {ev['detail']}")
                self.state["health"]["events"] = (self.state["health"]["events"] + [ev])[-20:]
                for disc in self.discs:
                    if disc["state"] in ACTIVE and disc["drive"] and port_covers(ev["port"], disc["drive"]["usb_port"]):
                        disc["suspect"].append(ev)
            self.paused_until = time.time() + self.cfg["health_pause_seconds"]
            self.save()

    # ---- main loop

    def start_next(self, jobs):
        pending = [d for d in self.discs if d["state"] == "pending"]
        if not pending or not may_start(time.time(), self.discs, self.cfg, self.gate_open_at, self.paused_until):
            return
        disc = pending[0]
        reason = self.preflight(disc)
        if reason:
            self.set_state(disc, "blocked", reason)
            return
        job = Job(self, disc)
        jobs.append(job)
        self.set_state(disc, "scanning")
        disc["started"] = now_iso()
        job.start()

    def stop_all(self):
        with self.lock:
            for proc in self.procs.values():
                if proc.poll() is None:
                    proc.terminate()

    def main(self):
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "stopping", True))
        signal.signal(signal.SIGINT, lambda *_: setattr(self, "stopping", True))
        mkvdev.write_makemkv_settings()

        known = mkvdev.drives()
        watch = HealthWatch(known)
        watch.poll_dmesg()
        self.state["health"]["dmesg"] = watch.dmesg
        self.save()

        for disc in self.discs:
            reason = self.preflight(disc)
            if reason:
                self.set_state(disc, "blocked", reason)

        jobs, last_dmesg = [], 0.0
        while not all(d["state"] in TERMINAL_DISC for d in self.discs):
            if self.stopping:
                self.stop_all()
                for d in self.discs:
                    if d["state"] == "pending":
                        self.set_state(d, "failed", "run was stopped before this disc started")
                if not any(j.is_alive() for j in jobs):
                    break
            else:
                events = watch.poll_sysfs()
                if time.time() - last_dmesg >= 5:
                    last_dmesg = time.time()
                    events += watch.poll_dmesg()
                    self.state["health"]["dmesg"] = watch.dmesg
                self.on_health(events)
                self.start_next(jobs)
                self.timeout_scans()
            self.save()
            time.sleep(1)

        for j in jobs:
            j.join()
        self.conclude()
        log(f"run {self.state['state']}")

    def conclude(self):
        """Derive the run's verdict from its discs. Also what finalize recomputes."""
        with self.lock:
            done = all(d["state"] == "done" for d in self.discs)
            self.state["state"] = "complete" if done else "incomplete"
            self.state["finished"] = self.state["finished"] or now_iso()
            self.state["problems"] = [{"index": d["index"], "serial": d["serial"], "state": d["state"],
                                       "reason": d["reason"]} for d in self.discs if d["state"] != "done"]
            self.save()

    def timeout_scans(self):
        """A disc that never leaves analysis would hold the single scanning slot
        forever and starve the rest of the run, so it is killed instead."""
        for d in self.discs:
            if d["state"] == "scanning" and d["started"]:
                started = datetime.datetime.fromisoformat(d["started"]).timestamp()
                proc = self.procs.get(d["index"])
                if proc and proc.poll() is None and time.time() - started > self.cfg["scan_timeout_seconds"]:
                    d["reason"] = f"still scanning after {self.cfg['scan_timeout_seconds']}s; killed"
                    proc.kill()


def info_command(dev, min_title_seconds):
    return ["makemkvcon", "-r", "--noscan", f"--minlength={min_title_seconds}", "info", f"dev:{dev}"]


def rip_command(dev, min_title_seconds, partial):
    return ["makemkvcon", "-r", "--noscan", "--progress=-same", f"--minlength={min_title_seconds}",
            "mkv", f"dev:{dev}", "all", partial]


def run_makemkvcon(cmd, log_path, parser, on_proc=None, on_line=None, timeout=None):
    """Run one makemkvcon, teeing its robot output to `log_path` and into `parser`.
    -> its exit status. `on_proc` receives the process so a watchdog can kill it;
    `timeout` is for callers with no watchdog of their own."""
    with open(log_path, "w") as raw:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, text=True, errors="replace")
        if on_proc:
            on_proc(proc)
        timer = threading.Timer(timeout, proc.kill) if timeout else None
        if timer:
            timer.start()
        try:
            for line in proc.stdout:
                raw.write(line)
                raw.flush()
                parser.feed(line)
                if on_line:
                    on_line()
            return proc.wait()
        finally:
            if timer:
                timer.cancel()


def parse_log(path, parser=None):
    parser = parser or RobotParser()
    with open(path, errors="replace") as fh:
        for line in fh:
            parser.feed(line)
    return parser


def sync_disc(disc, parser, min_title_seconds):
    """Mirror the parser's running tallies onto the disc record."""
    disc["titles_total"] = sum(1 for t in parser.titles
                               if (parser.title_seconds(t) or 0) >= min_title_seconds) or None
    # The step in flight is not finished, so it does not count as done yet.
    disc["titles_done"] = max(parser.saves_started - 1, 0)
    disc["errors"] = list(parser.errors) + parser.info_problems + [e["detail"] for e in disc["suspect"]]


def set_segment_titles(partial, manifest):
    for t in manifest["titles"]:
        r = subprocess.run(["mkvpropedit", os.path.join(partial, t["file"]),
                            "--edit", "info", "--set", f"title={t['segment_title']}"],
                           capture_output=True, text=True)
        if r.returncode >= 2:
            raise RuntimeError(f"mkvpropedit failed on {t['file']}: {r.stdout[-200:]}")


def build_manifest(disc, parser, partial, files):
    titles = []
    for fname, secs in sorted(files.items()):
        tid = title_for_file(parser, fname)
        a = parser.titles[tid]
        titles.append({
            "id": tid, "name": a.get(2), "file": fname, "chapters": a.get(8),
            "duration_seconds": parser.title_seconds(tid), "duration": a.get(9),
            "size_bytes": int(a[11]) if a.get(11, "").isdigit() else None,
            "source_playlist": a.get(16), "file_bytes": os.path.getsize(os.path.join(partial, fname)),
            "file_seconds": round(secs, 3), "segment_title": segment_title(disc["plan"])})
    return {"plan": disc["plan"], "drive": disc["drive"], "makemkv": parser.version,
            "disc_label": parser.disc.get(32) or parser.disc.get(2), "titles": titles,
            "errors": parser.errors, "suspect_events": disc["suspect"],
            "started": disc["started"], "copy_started": disc["copy_started"], "finished": now_iso()}


def finish_disc(run, disc, parser, rc, forced=None):
    """Verify a finished rip and, if it holds up, promote it out of .partial.

    The one tail shared by a disc's normal finish and by `finalize`, so a disc
    saved later goes through exactly the checks, manifest, titling, rename and
    eject a disc finished on time does. `forced` is a failure known before
    looking at the files (the scan watchdog's kill).
    """
    partial = disc["dest"] + ".partial"
    disc["reason"] = None
    disc["progress"] = {"phase": "verifying", "current": parser.pv_max, "total": parser.pv_max}
    files = {}
    for name in sorted(os.listdir(partial)):
        if name.lower().endswith(".mkv"):
            try:
                files[name] = duration(os.path.join(partial, name)) * 60
            except ValueError:
                files[name] = None
    bad = check_rip(rc, parser, files, run.cfg["min_title_seconds"])
    if forced:
        bad.insert(0, forced)
    disc["titles"] = len(files)
    sync_disc(disc, parser, run.cfg["min_title_seconds"])
    disc["titles_done"] = len(files)
    if bad:
        run.set_state(disc, "failed", "; ".join(bad) + f" (kept at {partial})")
        return
    manifest = build_manifest(disc, parser, partial, files)
    if disc["suspect"]:
        write_json(os.path.join(partial, "manifest.json"), manifest)
        run.set_state(disc, "suspect",
                      f"rip verified, but the USB tree reported {len(disc['suspect'])} error(s) "
                      f"under this drive; kept at {partial} for review")
        return
    set_segment_titles(partial, manifest)
    write_json(os.path.join(partial, "manifest.json"), manifest)
    if os.path.exists(disc["dest"]):
        run.set_state(disc, "failed", f"destination appeared during the rip: {disc['dest']}")
        return
    os.rename(partial, disc["dest"])
    try:
        mkvdev.eject(disc["drive"])
        disc["eject"] = "ok"
    except OSError as exc:
        disc["eject"] = f"failed: {exc}"
    run.set_state(disc, "done")


class Job(threading.Thread):
    """One disc: read its titles, rip it, verify it, then promote it out of .partial."""

    def __init__(self, run, disc):
        super().__init__(daemon=False)
        self.run_, self.disc = run, disc
        self.parser = RobotParser()
        self.partial = disc["dest"] + ".partial"

    def run(self):
        run, disc = self.run_, self.disc
        try:
            rc = self.rip()
            if rc is None:
                reasons = ([disc["reason"]] if disc["reason"] else []) + self.parser.info_problems
                run.set_state(disc, "failed", "; ".join(reasons) + " (no rip was attempted)")
                return
            finish_disc(run, disc, self.parser, rc, forced=disc["reason"])
        except Exception as exc:                      # noqa: BLE001 -- must not strand the slot
            run.set_state(disc, "failed", f"internal error: {exc!r}")

    def register(self, proc):
        with self.run_.lock:
            self.run_.procs[self.disc["index"]] = proc

    def rip(self):
        """-> makemkvcon's exit status, or None when the title info pass was bad
        and the rip was not started: copying hours of a disc that cannot be
        verified afterwards is the one thing not worth doing."""
        run, disc, p = self.run_, self.disc, self.parser
        min_len = run.cfg["min_title_seconds"]
        prefix = os.path.join(run.dir, f"disc-{disc['index']:02d}")

        info = RobotParser()
        info_rc = run_makemkvcon(info_command(disc["drive"]["dev"], min_len), prefix + ".info.log",
                                 info, on_proc=self.register)
        p.take_info(info, info_rc)
        sync_disc(disc, p, min_len)
        if p.info_problems or disc["reason"]:
            return None

        os.makedirs(self.partial)
        last_pct = -1.0

        def on_line():
            nonlocal last_pct
            if p.copying and disc["state"] == "scanning":
                disc["copy_started"] = now_iso()
                run.set_state(disc, "ripping")
            sync_disc(disc, p, min_len)
            if abs(p.percent - last_pct) >= 0.1:
                last_pct = p.percent
                disc["progress"] = {"phase": p.prgc or p.prgt, "current": p.pv_total, "total": p.pv_max}

        rc = run_makemkvcon(rip_command(disc["drive"]["dev"], min_len, self.partial), prefix + ".log",
                            p, on_proc=self.register, on_line=on_line)
        disc["makemkv_rc"] = rc
        p.check_announced()
        return rc


# ---------------------------------------------------------------------- CLI

def run_dir(run_id):
    if not re.fullmatch(r"[0-9A-Za-z-]+", run_id):
        raise SystemExit(f"FATAL: bad run id: {run_id!r}")
    d = os.path.join(RUNS_ROOT, run_id)
    if not os.path.isfile(os.path.join(d, "state.json")):
        raise SystemExit(f"FATAL: no such run: {run_id}")
    return d


def pid_alive(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            return b"mkv-rip" in fh.read()
    except OSError:
        return False


def load_status(run_id):
    with open(os.path.join(run_dir(run_id), "state.json")) as fh:
        st = json.load(fh)
    pid = st.get("controller_pid")
    alive = True if pid is None else pid_alive(pid)    # None: the controller is still being spawned
    st["controller_alive"] = alive
    if st["state"] not in TERMINAL_RUN and not alive:
        # The controller died without writing a verdict (pod restart, kill -9).
        # Saying "running" forever would hang every `wait`.
        st["state"] = "incomplete"
        st["reason"] = "controller died"
        st["finished"] = st["finished"] or now_iso()
        for d in st["discs"]:
            if d["state"] not in TERMINAL_DISC:
                d["state"], d["reason"] = "failed", "The controller died before this disc finished."
        st["problems"] = [{"index": d["index"], "serial": d["serial"], "state": d["state"],
                           "reason": d["reason"]} for d in st["discs"] if d["state"] != "done"]
        try:                                   # persist, so the verdict outlives this call
            write_json(os.path.join(RUNS_ROOT, run_id, "state.json"), st)
        except OSError:
            pass
    return st


def status_view(st):
    """The caller-facing shape of a run; state.json also carries controller internals."""
    h = st["health"]
    events = h["events"]
    return {
        "run_id": st["run_id"], "state": st["state"],
        "started_at": st["started"], "finished_at": st["finished"],
        "discs": [{"serial": d["serial"], "dest": d["dest"], "state": d["state"],
                   "reason": d["reason"], "progress": d["progress"],
                   "titles_done": d["titles_done"], "titles_total": d["titles_total"],
                   "errors": d["errors"]} for d in st["discs"]],
        "health": {"dmesg_available": h["dmesg"] == "ok", "paused": h["paused_until"] is not None,
                   "pause_reason": events[-1]["detail"] if h["paused_until"] and events else None},
    }


def active_run():
    """-> the id of a run still running, or None. Goes through load_status so a
    run whose controller died does not block new runs forever."""
    for run_id in sorted(os.listdir(RUNS_ROOT)) if os.path.isdir(RUNS_ROOT) else []:
        if os.path.isfile(os.path.join(RUNS_ROOT, run_id, "state.json")) \
                and load_status(run_id)["state"] == "running":
            return run_id
    return None


def refuse_if_busy():
    busy = active_run()
    if busy:
        sys.exit(f"FATAL: run {busy} is still running; wait for it (mkv-rip wait {busy}) "
                 "before starting another, since two controllers would not share the stagger.")


def finalize_holder():
    """-> the run id a `finalize` is working on right now, or None. The lock is
    held for the life of that process, so a crash releases it."""
    path = os.path.join(RUNS_ROOT, FINALIZE_LOCK)
    try:
        fh = open(path)
    except OSError:
        return None
    with fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return fh.read().strip() or "unknown"
    return None


def cmd_list():
    runs = []
    for run_id in sorted(os.listdir(RUNS_ROOT)) if os.path.isdir(RUNS_ROOT) else []:
        if os.path.isfile(os.path.join(RUNS_ROOT, run_id, "state.json")):
            st = load_status(run_id)
            runs.append({"run_id": run_id, "state": st["state"], "started_at": st["started"]})
    print(json.dumps(runs, indent=1))


def cmd_start(plan_path):
    try:
        with open(plan_path) as fh:
            cfg = validate_plan(json.load(fh))
    except (OSError, ValueError) as exc:
        sys.exit(f"FATAL: bad plan {plan_path}: {exc}")
    mkvdev.write_makemkv_settings()
    state_root()
    refuse_if_busy()
    finalizing = finalize_holder()
    if finalizing:
        sys.exit(f"FATAL: a finalize of run {finalizing} is in progress; wait for it to return "
                 "before starting a run, since its drives are spinning one at a time.")

    run_id = time.strftime("%Y%m%d-%H%M%S") + "-" + secrets.token_hex(2)
    d = os.path.join(RUNS_ROOT, run_id)
    os.makedirs(d)
    write_json(os.path.join(d, "plan.json"), cfg)
    run = Run(run_id)
    run.state["controller_pid"] = None
    run.save()
    with open(os.path.join(d, "controller.log"), "a") as out:
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_run", run_id],
                                stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                                start_new_session=True)
    run.state["controller_pid"] = proc.pid
    run.save()
    print(run_id)


def cmd_status(run_id):
    print(json.dumps(status_view(load_status(run_id)), indent=1))


def cmd_wait(run_id):
    while True:
        st = load_status(run_id)
        if st["state"] in TERMINAL_RUN:
            print(json.dumps(status_view(st), indent=1))
            sys.exit(0 if st["state"] == "complete" else 1)
        time.sleep(5)


# ----------------------------------------------------------------- finalize

def recorded_rc(disc, parser):
    """makemkvcon's exit status for a finished rip, or None when it cannot be known.

    Runs from before the title info pass stored no status. For those, a log whose
    last copy-complete line (MSG 5005) reports no failed titles, with no fatal
    message, stands in for a clean exit; anything else stays unknown, and unknown
    fails verification.
    """
    if disc.get("makemkv_rc") is not None:
        return disc["makemkv_rc"]
    if parser.saved is not None and parser.failed == 0 and not parser.fatal:
        return 0
    return None


def finalize_plan(st, run_path, drive_list):
    """-> (todo, skipped): which failed discs `finalize` would re-verify, and why
    the others are left alone. Reads only; spins nothing up.

    A disc qualifies when its .partial and rip log are still there, its drive
    holds media and links at 480, and the rip itself finished cleanly. A rip
    that is known to have died has nothing to re-verify, so its disc is not
    spun up for nothing.
    """
    by_serial = {d["serial"]: d for d in drive_list}
    todo, skipped = [], []
    for disc in st["discs"]:
        if disc["state"] != "failed":
            continue
        who = {"index": disc["index"], "serial": disc["serial"]}
        log_path = os.path.join(run_path, f"disc-{disc['index']:02d}.log")
        drive = by_serial.get(disc["serial"])
        if not os.path.isdir(disc["dest"] + ".partial"):
            why = f"no {disc['dest']}.partial to verify"
        elif not os.path.isfile(log_path):
            why = f"the rip log {log_path} is missing"
        elif drive is None:
            why = "its drive is not on the USB bus"
        elif not drive["media"]:
            why = f"no disc in the drive (tray {drive['tray']}, state {drive['status']})"
        elif drive["link_mbps"] != 480:
            why = f"link is {drive['link_mbps']} Mbit/s, not 480"
        else:
            parser = parse_log(log_path)
            rc = recorded_rc(disc, parser)
            if rc is None:
                why = "no recorded exit status, and the rip log has no clean copy-complete line"
            elif rc != 0:
                why = f"makemkvcon exited {rc}"
            else:
                todo.append({**who, "disc": disc, "drive": drive, "parser": parser, "rc": rc})
                continue
        skipped.append({**who, "reason": why})
    return todo, skipped


def finalize_disc(run, item):
    disc, drive, parser, rc = item["disc"], item["drive"], item["parser"], item["rc"]
    min_len = run.cfg["min_title_seconds"]
    disc["drive"] = {k: drive[k] for k in ("dev", "sg", "usb_port", "link_mbps")}
    disc["makemkv_rc"] = rc
    info = RobotParser()
    info_rc = run_makemkvcon(info_command(drive["dev"], min_len),
                             os.path.join(run.dir, f"disc-{disc['index']:02d}.info.log"), info,
                             timeout=run.cfg["scan_timeout_seconds"])
    parser.take_info(info, info_rc)
    parser.check_announced()
    finish_disc(run, disc, parser, rc)


def cmd_finalize(run_id, dry_run):
    if not dry_run:
        lock = open(os.path.join(RUNS_ROOT, FINALIZE_LOCK), "a+")    # held until this process exits
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            lock.seek(0)
            sys.exit(f"FATAL: a finalize of run {lock.read().strip() or 'unknown'} is already in progress.")
        lock.seek(0)
        lock.truncate()
        lock.write(run_id)
        lock.flush()
    busy = active_run()
    if busy:
        sys.exit(f"FATAL: run {busy} is still running; finalize re-verifies finished runs only, "
                 "and a second reader of the drives would break the stagger.")
    st = load_status(run_id)
    st.pop("controller_alive")
    run = Run(run_id, st)
    todo, skipped = finalize_plan(st, run.dir, mkvdev.drives())
    if dry_run:
        print(json.dumps({"would_finalize": [{k: t[k] for k in ("index", "serial")} for t in todo],
                          "skipped": skipped}, indent=1))
        return
    mkvdev.write_makemkv_settings()
    for n, item in enumerate(todo):
        if n:
            time.sleep(run.cfg["spinup_gap_seconds"])    # one drive spinning up at a time
        try:
            finalize_disc(run, item)
        except Exception as exc:                          # noqa: BLE001 -- the next disc still deserves its turn
            run.set_state(item["disc"], "failed", f"internal error during finalize: {exc!r}")
    run.conclude()
    out = status_view(run.state)
    out["skipped"] = skipped
    print(json.dumps(out, indent=1))
    sys.exit(0 if run.state["state"] == "complete" else 1)


# ----------------------------------------------------------------- selftest

# Trimmed from a real disc (Parallel World Pharmacy D1, 2026-11-09): the `mkv` run prints only the
# MSG 3307 announcements, never a TINFO; the `info` run has the table. (The 5005 line is
# the format makemkvcon prints at the end of a copy; the live log had not reached it yet.)
RIP_LOG = [
    'MSG:1005,0,1,"MakeMKV v2.0.0 linux(x64-release) started","%1 started","MakeMKV v2.0.0 linux(x64-release)"',
    'PRGT:5018,0,"Scanning CD-ROM devices"',
    'PRGT:3404,0,"Opening Blu-ray disc"',
    'MSG:3307,0,2,"File 00009.mpls was added as title #0","File %1 was added as title #%2","00009.mpls","0"',
    'MSG:3307,0,2,"File 00010.mpls was added as title #1","File %1 was added as title #%2","00010.mpls","1"',
    'MSG:3307,0,2,"File 00011.mpls was added as title #2","File %1 was added as title #%2","00011.mpls","2"',
    'MSG:3307,0,2,"File 00012.mpls was added as title #3","File %1 was added as title #%2","00012.mpls","3"',
    'MSG:3307,0,2,"File 00013.mpls was added as title #4","File %1 was added as title #%2","00013.mpls","4"',
    'MSG:3307,0,2,"File 00014.mpls was added as title #5","File %1 was added as title #%2","00014.mpls","5"',
    'MSG:3307,0,2,"File 00015.mpls was added as title #6","File %1 was added as title #%2","00015.mpls","6"',
    'MSG:3307,16777216,2,"File 00045.mpls was added as title #7","File %1 was added as title #%2","00045.mpls","7"',
    'MSG:3307,16777216,2,"File 00008.mpls was added as title #8","File %1 was added as title #%2","00008.mpls","8"',
    'MSG:3307,0,2,"File 00008.m2ts was added as title #9","File %1 was added as title #%2","00008.m2ts","9"',
    'MSG:3307,16777216,2,"File 00026.m2ts was added as title #10","File %1 was added as title #%2","00026.m2ts","10"',
    'PRGC:5017,0,"Saving to MKV file"',
    'MSG:5005,0,1,"Copy complete. 11 titles saved.","Copy complete. %1 titles saved.","11"',
]
INFO_LOG = [
    'MSG:5011,0,0,"Operation successfully completed","Operation successfully completed"',
    'TCOUNT:11',
    'CINFO:2,0,"Parallel World Pharmacy D1"',
    'CINFO:32,0,"ParallelWorldPharmacy_D1"',
