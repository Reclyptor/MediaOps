#!/usr/bin/env bash
# titlescan.sh FILE OUT.png START END STEP
#
# Hunt for an episode title card. Qwaser renders the title as a text overlay in
# the lower third of an ordinary shot, not as a full-screen card -- so this
# samples densely, crops each frame to the bottom strip where such an overlay
# lives, and tiles the strips. Forty-odd strips fit in one readable image, where
# forty full frames would not.
#
# ALWAYS run this against an episode whose card you have already seen before
# trusting a negative result. An instrument that silently finds nothing is
# indistinguishable from one that is pointed the wrong way.
set -euo pipefail

F="$1"; OUT="$2"; START="$3"; END="$4"; STEP="${5:-3}"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

i=0
t="$START"
while [ "$(echo "$t < $END" | bc)" -eq 1 ]; do
    i=$((i + 1))
    ffmpeg -nostdin -v error -ss "$t" -i "$F" -frames:v 1 \
        -vf "crop=iw:ih*0.24:0:ih*0.74,scale=760:-1,drawtext=text='${t}':x=6:y=4:fontsize=22:fontcolor=yellow:box=1:boxcolor=black@0.75" \
        -y "$TMP/$(printf %03d $i).png" 2>/dev/null || true
    t=$(echo "$t + $STEP" | bc)
done

rows=$(( (i + 1) / 2 ))
ffmpeg -nostdin -v error -pattern_type glob -i "$TMP/*.png" \
    -vf "tile=2x${rows}" -frames:v 1 "$OUT" -y
echo "$OUT  ($i strips, 2x${rows})"
