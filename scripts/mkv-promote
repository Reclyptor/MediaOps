#!/usr/bin/env python3
"""Move verified files into the library, with full accounting.

usage: mkv-promote MANIFEST.json [--go]
manifest: [{"src": "_pending/anime/X/a.mkv",
            "dst": "anime/X/Season 01/X - S01E01 - Title.mkv",
            "title": "X - S01E01 - Title"},   # optional MKV segment title
           ...]                                # paths relative to MEDIA_ROOT

Nothing is deleted; nothing is overwritten. Every check below exists because a
mis-promotion is expensive to unwind, and several of them exist because an
earlier version of this pipeline got it wrong.
"""
import json
import os
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

from mkvlib import MEDIA_ROOT, decode_check


def build(entries):
    moves = []
    for e in entries:
        src = os.path.join(MEDIA_ROOT, e["src"])
        dst = os.path.join(MEDIA_ROOT, e["dst"])
        if not os.path.isfile(src):
            sys.exit(f"FATAL: source missing: {src}")
        moves.append((src, dst, e.get("title")))

    srcs = [m[0] for m in moves]
    dsts = [m[1] for m in moves]
    if len(set(srcs)) != len(srcs):
        dupes = {s for s in srcs if srcs.count(s) > 1}
        sys.exit(f"FATAL: source mapped more than once: {sorted(dupes)[:5]}")
    if len(set(dsts)) != len(dsts):
        dupes = {d for d in dsts if dsts.count(d) > 1}
        sys.exit(f"FATAL: destination collision: {sorted(dupes)[:5]}")
    for d in dsts:
        if os.path.exists(d):
            sys.exit(f"FATAL: destination already occupied: {d}")
    return moves


def check_complete(entries, moves):
    """Every file in every source directory must be accounted for.

    An unmapped file is a hard error, never a silent skip -- a promotion that
    quietly leaves three episodes behind looks exactly like a successful one.
    """
    srcdirs = {os.path.dirname(os.path.join(MEDIA_ROOT, e["src"])) for e in entries}
    on_disk = set()
    for d in srcdirs:
        for root, _dirs, files in os.walk(d):
            on_disk.update(os.path.join(root, f) for f in files)
    missing = on_disk - {m[0] for m in moves}
    if missing:
        sys.exit(f"FATAL: {len(missing)} source files unaccounted for:\n  " +
                 "\n  ".join(sorted(missing)[:20]))


def touch_validate(moves):
    """Prove every destination is creatable before moving anything.

    Unicode, length limits and permissions all fail here rather than halfway
    through a batch with the library in a split state.
    """
    made = []
    try:
        for _s, d, _t in moves:
            os.makedirs(os.path.dirname(d), exist_ok=True)
            with open(d, "x"):
                pass
            made.append(d)
    except OSError as exc:
        for d in made:
            os.unlink(d)
        sys.exit(f"FATAL: destination not creatable: {exc}")
    for d in made:
        os.unlink(d)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip())
    go = "--go" in sys.argv
    with open(sys.argv[1]) as fh:
        entries = json.load(fh)

    moves = build(entries)
    check_complete(entries, moves)

    sizes = {s: os.path.getsize(s) for s, _d, _t in moves}
    print(f"{len(moves)} files, {sum(sizes.values())/2**40:.3f} TiB")
    for s, d, _t in moves[:40]:
        print(f"  {os.path.relpath(s, MEDIA_ROOT)}\n    -> {os.path.relpath(d, MEDIA_ROOT)}")
    if len(moves) > 40:
        print(f"  ... and {len(moves)-40} more")

    if not go:
        print("\ndry run -- pass --go to execute")
        return

    touch_validate(moves)

    for s, d, _t in moves:
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.move(s, d)

    for s, d, _t in moves:
        if not os.path.isfile(d):
            sys.exit(f"FATAL: destination missing after move: {d}")
        if os.path.getsize(d) != sizes[s]:
            sys.exit(f"FATAL: size mismatch after move: {d}")
    print(f"moved {len(moves)} files, all byte sizes match")

    mkvs = [(d, t) for _s, d, t in moves if d.endswith(".mkv")]
    failed = []
    with ThreadPoolExecutor(max_workers=12) as ex:
        for path, ok, detail in ex.map(lambda x: decode_check(x[0]), mkvs):
            if not ok:
                failed.append((path, detail))
    if failed:
        for p, why in failed:
            print(f"  DECODE FAIL {p}: {why}")
        sys.exit(f"FATAL: {len(failed)} of {len(mkvs)} files failed the decode check")
    print(f"decode-checked {len(mkvs)} mkv files, all readable")

    titled = 0
    for path, title in mkvs:
        if not title:
            continue
        r = subprocess.run(["mkvpropedit", path, "--edit", "info",
                            "--set", f"title={title}"],
                           capture_output=True, text=True)
        if r.returncode >= 2:
            sys.exit(f"FATAL: mkvpropedit failed on {path}:\n{r.stdout[-500:]}")
        titled += 1
    print(f"set container titles on {titled} files")

    for e in entries:
        d = os.path.dirname(os.path.join(MEDIA_ROOT, e["src"]))
        while d.startswith(MEDIA_ROOT) and d != MEDIA_ROOT \
                and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)


if __name__ == "__main__":
    main()
