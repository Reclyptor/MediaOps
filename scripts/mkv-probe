#!/usr/bin/env python3
"""Inventory a tree of mkv files as JSON lines.

usage: mkv-probe DIR [WORKERS] > inventory.jsonl

One record per file: relative path, bytes, duration in minutes, chapter count and
chapter start times, and the stream layout. This is the raw material every other
decision is made from -- classification is by DURATION, not by filename, because
MakeMKV names tracks `_t00`, `_t01` in disc order, which carries no meaning.
"""
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

from mkvlib import MEDIA_ROOT


def probe(path):
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-show_format", "-show_streams",
         "-show_chapters", "-of", "json", path],
        capture_output=True, text=True)
    if r.returncode != 0:
        return {"path": path, "error": (r.stderr.strip() or "ffprobe failed")[:200]}

    d = json.loads(r.stdout)
    chapters = [float(c["start_time"]) / 60 for c in d.get("chapters", [])]
    streams = [
        {"i": s.get("index"), "type": s.get("codec_type"), "codec": s.get("codec_name"),
         "lang": (s.get("tags") or {}).get("language"),
         "title": (s.get("tags") or {}).get("title")}
        for s in d.get("streams", [])
    ]
    fmt = d.get("format", {})
    return {
        "path": path,
        "rel": os.path.relpath(path, MEDIA_ROOT),
        "size": int(fmt.get("size", 0)),
        "dur": round(float(fmt.get("duration", 0)) / 60, 3),
        "title": (fmt.get("tags") or {}).get("title"),
        "nchapters": len(chapters),
        "chapters": [round(c, 3) for c in chapters],
        "streams": streams,
    }


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip())
    root = sys.argv[1]
    workers = int(sys.argv[2]) if len(sys.argv) > 2 else 12

    files = []
    for dirpath, _dirs, names in os.walk(root):
        files.extend(os.path.join(dirpath, n) for n in sorted(names)
                     if n.lower().endswith(".mkv"))
    files.sort()
    print(f"probing {len(files)} files with {workers} workers", file=sys.stderr)

    with ThreadPoolExecutor(max_workers=workers) as ex:
        for rec in ex.map(probe, files):
            print(json.dumps(rec))


if __name__ == "__main__":
    main()
